#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install --destdir=debian/mcp-server-groupoffice

override_dh_auto_test:
	appstreamcli validate --no-net debian/mcp-server-groupoffice.metainfo.xml
	# Skip pybuild's default unittest discovery: tests/test_*.py uses
	# pytest, which isn't packaged as a build-dependency here.

override_dh_install:
	dh_install
	install -D -m644 debian/mcp-server-groupoffice.metainfo.xml \
		debian/mcp-server-groupoffice/usr/share/metainfo/cz.vitexsoftware.mcp-server-groupoffice.metainfo.xml
	install -D -m644 debian/mcp-server-groupoffice.svg \
		debian/mcp-server-groupoffice/usr/share/icons/hicolor/scalable/apps/mcp-server-groupoffice.svg
