# Example environment variables for GroupOffice MCP Server

# Required: base URL of your GroupOffice instance (no trailing path -
# /api/jmap.php, /api/upload.php, /api/download.php are appended internally).
GROUPOFFICE_URL=https://your-groupoffice-instance.example.com

# Required: API bearer token. Generate one in your GroupOffice instance under
# System Settings -> API Keys (requires the "API keys" community module).
GROUPOFFICE_API_TOKEN=your-api-token

# Optional: SSL verification (default: true)
GROUPOFFICE_VERIFY_SSL=true

# Optional: request timeout in seconds (default: 30)
GROUPOFFICE_TIMEOUT=30

# Optional: connection-level retries for transient network errors (default: 3)
GROUPOFFICE_MAX_RETRIES=3

# Optional: enable debug logging (default: false)
GROUPOFFICE_DEBUG=false

# Optional: read-only mode (default: true). When true, all mutating tools
# (create/update/delete/upload) are rejected before any API call is made.
# Set to false to allow writes.
GROUPOFFICE_READONLY=true
